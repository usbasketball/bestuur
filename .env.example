# Auth0 (authentication)
AUTH0_DOMAIN="auth.usbasketball.nl"
AUTH0_CLIENT_ID=""
AUTH0_SECRET=""

# Namespace used for Auth0 custom claims (must match your Auth0 Action).
# Defaults to "https://{AUTH0_DOMAIN}" if not set.
AUTH0_NAMESPACE="https://usbasketball.nl"

# 32-byte secret used to encrypt session cookies. Generate with: openssl rand -hex 32

# Base URL of this app. In the Auth0 application settings register:
#   - "<APP_BASE_URL>/auth/callback" under Allowed Callback URLs
#   - "<APP_BASE_URL>" under Allowed Logout URLs
APP_BASE_URL="http://localhost:3000"

# Database (PostgreSQL)
DATABASE_URL=""
DIRECT_URL=""

# Auth0 Management API (for sync script)
# Use the actual Auth0 domain (not the custom domain used for login)
AUTH0_M2M_DOMAIN="usbasketball.eu.auth0.com"
AUTH0_M2M_CLIENT_ID=""
AUTH0_M2M_CLIENT_SECRET=""

# FOYS API (for sync script)
FOYS_API_KEY=""

# Sentry (error monitoring & tracing)
# DSN from your Sentry project settings. Leave empty to disable in local dev.
SENTRY_DSN=""
# Auth token for source-map uploads. Never commit this value.
# Set in Vercel for Production + Preview builds.
SENTRY_AUTH_TOKEN=""
