enum TeamType {
  VSE1
  VSE2
  VSE3
  VSE4
  VSE5
  VSE6
  MSE1
  MSE2
  MSE3
  MSE4
  MSE5
  MSE6
  V3x3
}

enum Discipline {
  DISCIPLINE_5x5
  DISCIPLINE_3x3
}

enum FieldType {
  CENTER_COURT
  VELD_1
  VELD_2
  VELD_3
}

enum MatchStatus {
  CANCELLED
  FINAL
  PLANNED
  WITHDRAWN
}

enum ClubMembershipType {
  COMPETITION
  RECREATIONAL
}

enum CommitteeType {
  BOARD_CHAIRPERSON
  BOARD_SECRETARY
  BOARD_TREASURER
  BOARD_GAME_SECRETARY
  BOARD_GENERAL_MEMBER
  OMNI
}

model Team {
  id                     String     @id @default(uuid())
  foysCompetitionTeamId  Int        @unique @map("foys_competition_team_id")
  foysTeamId             Int?       @unique @map("foys_team_id")
  name                   String?
  season                 String
  teamType               TeamType   @map("team_type")
  discipline             Discipline @default(DISCIPLINE_5x5)

  createdAt              Timestamp  @default(now()) @map("created_at")
  updatedAt              temporal.updatedAt() @map("updated_at")

  @@index([teamType])
  @@index([season])
  @@map("teams")
}

model InterestSubmission {
  id          String   @id @default(uuid())
  name        String
  email       String
  birthDate   Timestamp @map("birth_date")
  position    String
  interest    String
  gender      String
  lastLevel   String?  @map("last_level")
  lastSeason  String?  @map("last_season")
  background  String?
  locale      String   @default("nl")
  createdAt   Timestamp @default(now()) @map("created_at")

  @@index([email])
  @@map("interest_submissions")
}

model Match {
  id                  String   @id @default(uuid())
  foysMatchId         Int      @unique @map("foys_match_id")
  status              MatchStatus
  date                Timestamp
  startTime           String?  @map("start_time")
  isFriendly          Boolean  @default(false) @map("is_friendly")
  homeScore           Int?     @map("home_score")
  awayScore           Int?     @map("away_score")
  homeTeamFoysId      Int      @map("home_team_foys_id")
  awayTeamFoysId      Int      @map("away_team_foys_id")
  awayTeamName        String?  @map("away_team_name")
  awayOrganisationId  String?  @map("away_organisation_id")
  awayOrganisationName String? @map("away_organisation_name")
  competitionId       Int?     @map("competition_id")
  competitionTypeName String?  @map("competition_type_name")
  field               FieldType?

  createdAt   Timestamp  @default(now()) @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")

  @@index([homeTeamFoysId])
  @@index([date])
  @@index([status])
  @@map("matches")
}

model User {
  id                String  @id @default(uuid())
  auth0Sub          String? @unique @map("auth0_sub")
  email             String  @unique
  firstName         String? @map("first_name")
  lastNamePrefix    String? @map("last_name_prefix")
  lastName          String? @map("last_name")
  nbbNumber         String? @unique @map("nbb_number")
  foysUserId        String? @unique @map("foys_user_id")
  refereeLevel      String? @map("referee_level")
  memberSince       Timestamp? @map("member_since")

  memberships       ClubMembership[]
  coaches           Coach[]
  committees        Committee[]
  hallDuties        HallDuty[]

  createdAt         Timestamp  @default(now()) @map("created_at")
  updatedAt         temporal.updatedAt() @map("updated_at")

  @@map("users")
}

model ClubMembership {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  season          String
  primaryTeam     TeamType?       @map("primary_team")
  registeredTeam  TeamType?       @map("registered_team")
  membershipType  ClubMembershipType  @map("membership_type")
  cancelledAt     Timestamp?      @map("cancelled_at")

  user            User            @relation(fields: [userId], references: [id])

  createdAt       Timestamp       @default(now()) @map("created_at")
  updatedAt       temporal.updatedAt() @map("updated_at")

  @@unique([userId, season])
  @@index([season])
  @@map("club_memberships")
}

model Coach {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  team      TeamType
  season    String

  user      User     @relation(fields: [userId], references: [id])

  createdAt Timestamp @default(now()) @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  @@index([season])
  @@map("coaches")
}

model Committee {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  type      CommitteeType
  season    String

  user      User           @relation(fields: [userId], references: [id])

  createdAt Timestamp      @default(now()) @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  @@index([season])
  @@map("committees")
}

model HallDuty {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  season    String

  user      User     @relation(fields: [userId], references: [id])

  createdAt Timestamp @default(now()) @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  @@index([season])
  @@map("hall_duties")
} 

// ---------------------------------------------------------------
// New models for takenschema automation
// ---------------------------------------------------------------

enum TaskType {
  HALL_DUTY
  REFEREE
  TABLE_SCORER
  TABLE_TIMER
  TABLE_24S_SHOT_CLOCK
}

model Task {
  id        String   @id @default(uuid())
  matchId   String   @map("match_id")
  taskType  TaskType
  createdAt Timestamp @default(now()) @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  match     Match    @relation(fields: [matchId], references: [id])
  assignments TaskAssignment[]

  @@index([matchId])
  @@map("tasks")
}

model TaskAssignment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String?  @map("user_id")
  nbbNumber String?  @map("nbb_number")
  isDouble  Boolean  @default(false)
  createdAt Timestamp @default(now()) @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  task      Task     @relation(fields: [taskId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignments")
}

model HistoricTaskBalance {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  season    String
  taskType  TaskType
  count     Int      @default(0)
  createdAt Timestamp @default(now()) @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, season, taskType])
  @@index([season])
  @@map("historic_task_balances")
}

